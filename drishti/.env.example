# Copy this file to .env and fill in only what you need. Never commit .env
# (it is listed in .gitignore).
#
# Optional AI for the "Ask the map" box, used only by `npm run dev` on your
# own computer. The live site never uses it, and the key never reaches a browser.
#
#   ollama : free, runs on your Mac (install from https://ollama.com,
#            then run `ollama pull llama3.2`). No key needed.
#   gemini : Google AI Studio free tier. Put your key in ASK_AI_API_KEY.
#
# Leave ASK_AI_PROVIDER empty to use the built-in rules only.
ASK_AI_PROVIDER=
ASK_AI_API_KEY=
ASK_AI_MODEL=
